{
  "name": "thehive-cortex-mcp",
  "version": "1.2.0",
  "description": "MCP server for Cortex observable analysis and response engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cortex-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "author": "Solomon Neas <me@solomonneas.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lidless-labs/cortex-mcp.git"
  },
  "homepage": "https://github.com/lidless-labs/cortex-mcp#readme",
  "bugs": {
    "url": "https://github.com/lidless-labs/cortex-mcp/issues"
  },
  "keywords": [
    "mcp",
    "cortex",
    "thehive",
    "soc",
    "security",
    "observable-analysis",
    "incident-response"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
